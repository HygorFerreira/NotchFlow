    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow reads song information and controls playback in Spotify or Apple Music when you enable music in the notch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchFlow lê as informações das músicas e controla a reprodução no Spotify ou Apple Music quando você ativa música no notch."
          }
        }
      }
    },
