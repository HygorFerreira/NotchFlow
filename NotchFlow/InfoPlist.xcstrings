    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NotchFlow shows today's events next to your tasks. It only reads your calendar and never writes to it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O NotchFlow mostra os eventos do dia ao lado das suas tarefas. Ele só lê o seu calendário e nunca escreve nele."
          }
        }
      }
    },
