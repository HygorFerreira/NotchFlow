    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow processes audio locally to control the volume of each app. Audio is never saved or sent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchFlow processa o áudio localmente para controlar o volume de cada aplicativo. O áudio nunca é salvo ou enviado."
